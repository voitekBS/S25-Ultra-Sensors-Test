    <!-- Needle, north half -->
    <path
        android:pathData="M54,38 L59,54 L49,54 Z"
        android:fillColor="#FFFFB547" />

    <!-- Needle, south half -->
    <path
        android:pathData="M54,70 L59,54 L49,54 Z"
        android:fillColor="#FF5EEAD4" />

    <!-- Hub -->
    <path
        android:pathData="M54,51.5 a2.5,2.5 0 1,1 -0.01,0 Z"
        android:fillColor="#FF0B0E11" />
